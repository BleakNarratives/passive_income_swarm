# DVM worker runtime config (loaded by systemd EnvironmentFile).
# Flip DVM_PAID_ONLY=1 to gate free jobs behind LNURL-pay invoices.
# 0 = reputation mode (serve all jobs free)  |  1 = paid-to-play
DVM_PAID_ONLY=0

# Payment polling (used when DVM_PAID_ONLY=1)
DVM_PAYMENT_TIMEOUT=120
DVM_PAYMENT_POLL=3

# Fee schedule (msat): text-gen 50 sats, summarize 20 sats — enforced in code
# when paid mode is on (kind 5002 -> 50_000, kind 5003 -> 20_000).
